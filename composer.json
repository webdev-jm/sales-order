{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "C:/Users/jm.renon/Documents/2026/PROJECTS/hub-auth-client",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "bevi-webdev-jm/hub-auth-client": "@dev",
        "guzzlehttp/guzzle": "^7.9",
        "intervention/image": "^2.7",
        "jeroennoten/laravel-adminlte": "^3.16",
        "laravel/ai": "^1.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.20",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.6",
        "league/flysystem": "^3.29",
        "league/flysystem-ftp": "^3.29",
        "league/flysystem-sftp-v3": "^3.29",
        "livewire/livewire": "^4.1",
        "maatwebsite/excel": "^3.1.64",
        "milon/barcode": "^12.0",
        "opencage/geocode": "^3.3",
        "rap2hpoutre/laravel-log-viewer": "^2.5",
        "silviolleite/laravelpwa": "^2.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-html": "^3.12",
        "spatie/laravel-permission": "^6.16",
        "spatie/simple-excel": "^3.7"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.15",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.4",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
