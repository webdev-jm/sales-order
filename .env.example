APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

HUB_URL=http://localhost:8000
HUB_CLIENT_ID=
HUB_CLIENT_SECRET=
HUB_REDIRECT_URI="${APP_URL}/login/hub/callback"
HUB_DEFAULT_ROLE=default_user

EMAIL_NOTIFICATION=false
XML_GENERATION_ENABLED=true

# AI: only the API keys go here. The main provider, backups, models and server addresses are set on the AI Settings page.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
QWEN_API_KEY=

# The maintenance page (config/maintenance.php). Run php artisan config:cache after changing these.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=
MAINTENANCE_UNTIL=
MAINTENANCE_SECRET=
MAINTENANCE_ALLOWED_IPS=
# Turns it on by itself at this time (e.g. 2026-11-24 17:00), counting down on every page for the minutes before it.
MAINTENANCE_STARTS_AT=
MAINTENANCE_WARNING_MINUTES=30
